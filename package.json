{
  "name": "testautomation-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:login": "playwright test tests/e2e/login.spec.ts",
    "test:session": "playwright test tests/e2e/session.spec.ts",
    "test:a11y": "playwright test tests/a11y",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:slow": "SLOWMO=500 playwright test tests/e2e --headed --workers=1",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.6"
  }
}
